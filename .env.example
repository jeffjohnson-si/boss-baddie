# ---------------------------------------------------------------
# BOSS BADDIE environment variables
# Copy to .env.local for local dev; set these in your host's
# dashboard for production. Never commit .env.local.
# ---------------------------------------------------------------

# Admin dashboard (Patricia) login.
# The first account is created once at /admin/register while admin_users is empty.
# ADMIN_EMAIL / ADMIN_PASSWORD are a BOOTSTRAP only: they stop working as soon as
# a real account exists. ADMIN_SESSION_SECRET signs the session cookie.
ADMIN_EMAIL=patricia@bossbaddie.sb
ADMIN_PASSWORD=change-me-before-launch
# Random 32+ character string. Signs the admin session cookie.
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# Shop customers' session cookie. A SECOND distinct 32+ character string: an
# account that can spend money and see collection details must not share a signing
# key with the admin dashboard. Customers are passwordless: they sign in with a
# phone number and a texted six-digit code.
CUSTOMER_SESSION_SECRET=replace-with-a-third-long-random-string

# ---------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------
# The application connects with a DML-only role (SELECT/INSERT/UPDATE/DELETE),
# never the database owner. Create that role once, then use it below.
DATABASE_URL=postgresql://bossbaddie_app:change-me@db.example.com:5432/bossbaddie?sslmode=verify-full

# Used ONLY by `npm run db:migrate` and `npm run db:backup`. It needs DDL/read
# rights, so it is the database owner (or a role with CREATE on the schema).
# Keep it out of production runtime.
DATABASE_ADMIN_URL=postgresql://neondb_owner:change-me@db.example.com:5432/bossbaddie?sslmode=verify-full

# ---------------------------------------------------------------
# SMS — the sign-up verification code
# ---------------------------------------------------------------
# A new account is only created after a six-digit code has been texted to the
# number and typed back. HOW those texts are sent is this setting:
#
#   console  (default) — prints the message in the server log. Nothing is sent,
#            nothing costs money. Use it for development.
#   twilio   — real SMS via the Twilio Messages API. Fill in the three values
#            below; the From number must be one Twilio has given you.
#
# SMS_PROVIDER=console
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-auth-token
# EITHER a single sender number, or a Messaging Service (Twilio's preferred way to
# send — it handles sender selection for you):
# TWILIO_FROM=+677xxxxxxxx
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# TRIAL ACCOUNTS: Twilio only delivers to numbers you have verified in the console
# until the account is upgraded (error 21608). Verify your own phone first, then
# use POST /api/admin/sms-test while signed in to check the wiring.

# LOCAL TESTING ONLY. When set to 1, the API response for a sign-up includes the
# code it just "sent", so the flow can be completed on a laptop. NEVER set this on
# a deployed server — it hands the code to anyone filling in the form.
# SMS_DEV_SHOW_CODE=1

# LOCAL PREVIEW ONLY. Enables two shortcuts so the pages behind the gates can be
# reviewed without an SMS or Patricia's password:
#   /api/dev/login        + "Skip Sign-In" on the sign-in / sign-up pages
#   /api/dev/admin-login  + "Skip Admin Login" on /admin/login
# It must NEVER be set on a deployed server: anyone with the URL becomes a customer
# or the owner. Both routes return 404 when the flag is absent.
# DEV_LOGIN_ENABLED=1
# DEV_LOGIN_PHONE=7412345

# ---------------------------------------------------------------
# Email — password resets and recovery-email verification
# ---------------------------------------------------------------
# console  development: prints the message and link to the server log
# brevo    production: Brevo's transactional API. Verify the sender address in
#          the Brevo dashboard before using it.
EMAIL_PROVIDER=console
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=BOSS BADDIE

# The public address of the site, with the scheme. Used to build the absolute
# URLs in share cards, canonical tags and password-reset emails. Leave it unset
# locally; production must set the real https:// address.
# NEXT_PUBLIC_SITE_URL=https://bossbaddie.sb

# ---------------------------------------------------------------
# Images — Cloudinary (free plan, no card)
# ---------------------------------------------------------------
# Product photos go to Cloudinary in production. Leave these blank locally to
# keep writing to public/uploads.
# Console → Settings → API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=uploads

# NOTE: orders, products, customers, login codes and admin accounts live
# in PostgreSQL. Uploaded pictures go to Cloudinary in production (or
# public/uploads locally). Netlify has an ephemeral filesystem, so uploads must
# use Cloudinary there.

# Public contact + collection details. Printed on the checkout page, the shop
# sidebar, the contact page, the footer and both printed documents.

# NEXT_PUBLIC_ vars are visible in the browser — never put secrets here.
# There are deliberately NO bank variables: payment is cash on collection only,
# so the site has no account details to publish.
# REPLACE THIS — the number below is not real, and it renders as a live tel:
# link in the footer and on the contact page.
NEXT_PUBLIC_WHATSAPP=+677 000 0000
NEXT_PUBLIC_PICKUP_LOCATION=Honiara, Solomon Islands

# Facebook page and email address, shown on the contact page. BOTH ARE OPTIONAL:
# leave one blank and that row is not rendered at all, rather than showing a dead
# link. Give the Facebook value in full, with the scheme.
# REPLACE THESE — the values below are not real.
NEXT_PUBLIC_FACEBOOK=https://www.facebook.com/replace-with-real-page
NEXT_PUBLIC_CONTACT_EMAIL=replace-with-real@example.com
